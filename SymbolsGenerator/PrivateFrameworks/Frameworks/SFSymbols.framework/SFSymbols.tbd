--- !tapi-tbd
# Linker stub for the private /System/Library/PrivateFrameworks/SFSymbols.framework (it lives in the dyld shared
# cache, so there is no file to link against). Lists only the symbols used through ../../Modules/SFSymbols.swiftmodule;
# regenerate the list with `nm -u` on an object file that uses the module when adding declarations there.
tbd-version: 4
targets: [ x86_64-macos, arm64-macos, arm64e-macos ]
install-name: '/System/Library/PrivateFrameworks/SFSymbols.framework/Versions/A/SFSymbols'
exports:
